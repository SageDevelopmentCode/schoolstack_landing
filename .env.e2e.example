# Copy to .env.e2e.local for local E2E runs (gitignored via .env*).
# Use keys from `supabase status` after `supabase start`.
# Never use production Supabase or Stripe credentials here.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Stripe keys intentionally omitted for E2E.

# Seeded test users (created by e2e/fixtures/seed.ts on each test run)
E2E_ADMIN_EMAIL=e2e-admin@schoolstack.test
E2E_PARENT_EMAIL=e2e-parent@schoolstack.test
E2E_NONADMIN_EMAIL=e2e-nonadmin@schoolstack.test
E2E_TEST_PASSWORD=E2eTestPassword123!

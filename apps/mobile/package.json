{
  "name": "@schoolstack/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/ui": "~57.0.11",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.14",
    "expo-constants": "~57.0.12",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "^57.0.1",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.14",
    "expo-secure-store": "^57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "NODE_PATH=./node_modules:../../node_modules expo start",
    "android": "NODE_PATH=./node_modules:../../node_modules expo start --android",
    "ios": "NODE_PATH=./node_modules:../../node_modules expo start --ios",
    "web": "NODE_PATH=./node_modules:../../node_modules expo start --web",
    "lint": "expo lint",
    "lint:errors": "expo lint -- --quiet",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "maestro test .maestro",
    "test:e2e:android:build": "expo prebuild --platform android && cd android && ./gradlew assembleDebug",
    "test:e2e:ios": "maestro test .maestro",
    "test:e2e:ios:build": "expo prebuild --platform ios && xcodebuild -workspace ios/MudKitchen.xcworkspace -scheme MudKitchen -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build CODE_SIGNING_ALLOWED=NO",
    "test:e2e:ios:run": "bash scripts/run-e2e-ios.sh",
    "test:e2e:android:run": "bash scripts/run-e2e-android.sh"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    }
  }
}

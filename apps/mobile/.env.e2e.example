# Optional: copy to `.env.e2e.local` for LOCAL Maestro E2E only (gitignored).
# Not required for normal dev, lint, unit tests, or CI (CI injects env vars in the workflow).
#
# Fill EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY from:
#   supabase status --output json | jq -r '.PUBLISHABLE_KEY // .ANON_KEY'
#
# Or run from repo root: npm run mobile:e2e:env -- ios
#                       npm run mobile:e2e:env -- android

# --- iOS simulator (local) — simulator reaches the Mac host directly ---
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<from supabase status>
# EXPO_PUBLIC_SITE_URL=http://127.0.0.1:3100

# --- Android emulator (local) — use 10.0.2.2 instead of 127.0.0.1 ---
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<from supabase status>
EXPO_PUBLIC_SITE_URL=http://10.0.2.2:3100

# Shared with web Playwright E2E (optional locally; hardcoded in Maestro flows)
E2E_ADMIN_EMAIL=e2e-admin@schoolstack.test
E2E_TEST_PASSWORD=E2eTestPassword123!

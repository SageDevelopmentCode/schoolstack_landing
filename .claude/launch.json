{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "landing-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:next"
      ],
      "port": 3000
    },
    {
      "name": "landing-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "dream-studio",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd video/mudkitchen-film && npx remotion studio --port 3123 --no-open"
      ],
      "port": 3123
    }
  ]
}
